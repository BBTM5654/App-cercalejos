<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4EEFF"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp"
        android:gravity="center_horizontal">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="App17_Proximidad"
            android:textColor="#60418F"
            android:textSize="25sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="14dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="by Braulio Torres"
            android:textColor="#8C72B5"
            android:textSize="15sp"
            android:gravity="center"
            android:paddingBottom="22dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:padding="22dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Estado del sensor"
                android:textColor="#6E4AA5"
                android:textSize="17sp"
                android:textStyle="bold"
                android:gravity="center" />
            <TextView
                android:id="@+id/tvEstado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Esperando lectura..."
                android:textColor="#292039"
                android:textSize="29sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingTop="18dp"
                android:paddingBottom="10dp" />
            <TextView
                android:id="@+id/tvValor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Valor lógico: --"
                android:textColor="#6B607A"
                android:textSize="17sp"
                android:gravity="center"
                android:paddingBottom="8dp" />
            <TextView
                android:id="@+id/tvDistancia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Distancia física: --"
                android:textColor="#6B607A"
                android:textSize="15sp"
                android:gravity="center" />
        </LinearLayout>
        <TextView
            android:id="@+id/tvSensor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Buscando sensor de proximidad..."
            android:textColor="#60418F"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingTop="18dp"
            android:paddingBottom="12dp" />
        <Button
            android:id="@+id/btnVoz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detener lectura en voz alta"
            android:backgroundTint="#9B78D0"
            android:textColor="#FFFFFF" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="La app anuncia el estado cada 2 segundos. La vibración se activa al detectar cercanía."
            android:textColor="#76668E"
            android:textSize="13sp"
            android:gravity="center"
            android:paddingTop="14dp" />
    </LinearLayout>
</ScrollView>
